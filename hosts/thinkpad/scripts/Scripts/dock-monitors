#!/usr/bin/env bash
# Docked layout: three external screens in a fixed arrangement, laptop panel
# off while the dock is connected. `--watch` re-applies it on every hotplug.
#
# Screens are matched by EDID "make model serial", decoded the way wlroots does,
# because the DisplayLink outputs swap names across reconnects. Use arandr to
# find a layout, then copy the geometry into `screens`.
#
# Only runs xrandr when something differs: a mode set can emit a DRM uevent,
# and an unconditional apply would wake the watcher in a loop.

set -euo pipefail

# Laptop panel.
panel='Lenovo Group Limited 0x403D Unknown'

# identity | mode | position | dock
# `dock` marks the DisplayLink screens: only their presence turns the panel off,
# so a lone HDMI monitor (a projector) does not.
screens=(
    'PEB 777K 806020102|1024x768@84.997Hz|1208 430|'
    'LG Electronics LG FULL HD 0x01010101|1920x1080@74.973Hz|2232 118|dock'
    'AOP 22MH1Q 901123123LAJ|1920x1080@60.0Hz|4152 118|dock'
)

# X shows a DisplayLink (evdi) provider's outputs only once it is attached to
# the GPU as an output sink.
attach_providers() {
    local line idx
    while IFS= read -r line; do
        [[ $line =~ ^Provider\ ([0-9]+):.*Sink\ Output.*associated\ providers:\ 0 ]] || continue
        idx=${BASH_REMATCH[1]}
        (( idx == 0 )) && continue
        xrandr --setprovideroutputsource "$idx" 0 || true
    done < <(xrandr --listproviders)
}

# xrandr arguments to reach the layout, one per line; empty when it is right.
plan() {
    xrandr --verbose | python3 -c '
import re, sys

panel = sys.argv[1]
desired = [entry.split("|") for entry in sys.argv[2:]]

pnp = {}
try:
    with open("/usr/share/hwdata/pnp.ids", encoding="utf-8", errors="replace") as f:
        for line in f:
            code, _, name = line.rstrip("\n").partition("\t")
            if name:
                pnp[code] = name
except OSError:
    pass  # no hwdata: the make falls back to the three-letter code

def identity(edid):
    code = (edid[8] << 8) | edid[9]
    pnpid = "".join(chr(((code >> s) & 0x1f) + 64) for s in (10, 5, 0))
    product = edid[10] | (edid[11] << 8)
    number = int.from_bytes(edid[12:16], "little")
    name = serial = None
    for off in range(54, 126, 18):
        d = edid[off:off + 18]
        if d[0:3] == b"\0\0\0":
            text = d[5:18].split(b"\n")[0].decode("cp437").strip()
            if d[3] == 0xFC:
                name = text
            elif d[3] == 0xFF:
                serial = text
    return "%s %s %s" % (pnp.get(pnpid, pnpid), name or "0x%04X" % product,
                         serial or ("0x%08X" % number if number else "Unknown"))

# Per connected output: EDID, active, position, rotation, current mode.
outputs = {}
cur = None
in_edid = False
in_current_mode = False
for line in sys.stdin:
    m = re.match(r"^(\S+) (connected|disconnected)", line)
    if m:
        cur = None
        in_edid = in_current_mode = False
        if m.group(2) == "connected":
            g = re.search(r" (\d+)x(\d+)\+(\d+)\+(\d+) \(0x[0-9a-f]+\) (\w+)", line)
            cur = {"name": m.group(1), "edid": "", "active": bool(g)}
            if g:
                cur.update(w=int(g.group(1)), h=int(g.group(2)), x=int(g.group(3)),
                           y=int(g.group(4)), rotate=g.group(5))
            outputs[cur["name"]] = cur
        continue
    if cur is None:
        continue
    if line.strip() == "EDID:":
        in_edid = True
        continue
    if in_edid:
        if re.fullmatch(r"\s+[0-9a-f]{32}\s*", line):
            cur["edid"] += line.strip()
            continue
        in_edid = False
    if re.match(r"^\s+\d+x\d+i? \(0x[0-9a-f]+\)", line):
        in_current_mode = "*current" in line
        continue
    if in_current_mode:
        r = re.search(r"clock\s+([\d.]+)Hz", line)
        if r:
            cur["refresh"] = float(r.group(1))
            in_current_mode = False

seen = {}
for o in outputs.values():
    if len(o["edid"]) >= 256:
        seen[identity(bytes.fromhex(o["edid"][:256]))] = o

def mode_parts(spec):
    res, _, rate = spec.partition("@")
    w, h = res.split("x")
    return int(w), int(h), float(rate.rstrip("Hz"))

args = []
docked = False

for ident, mode, pos, dock in desired:
    o = seen.get(ident)
    if o is None:
        continue
    if dock == "dock":
        docked = True

    x, y = (int(v) for v in pos.split())
    mw, mh, mr = mode_parts(mode)
    right = (o["active"] and (o["x"], o["y"]) == (x, y) and o["rotate"] == "normal"
             and (o["w"], o["h"]) == (mw, mh) and abs(o.get("refresh", 0) - mr) < 1)
    if not right:
        args.append("--output %s --mode %dx%d --rate %.3f --pos %dx%d --rotate normal --scale 1x1"
                    % (o["name"], mw, mh, mr, x, y))

p = seen.get(panel)
if p is not None:
    if docked and p["active"]:
        args.append("--output %s --off" % p["name"])
    elif not docked and not p["active"]:
        args.append("--output %s --auto --pos 0x0 --rotate normal --scale 1x1" % p["name"])

for a in args:
    print(a)
' "$panel" "${screens[@]}"
}

apply() {
    attach_providers

    local -a args=()
    local line
    while IFS= read -r line; do
        [[ -n $line ]] || continue
        read -r -a parts <<<"$line"
        args+=("${parts[@]}")
    done < <(plan)

    (( ${#args[@]} )) || return 0

    # One call so the screens move together. If a rate is refused, retry
    # without rates rather than lose the arrangement.
    if ! xrandr "${args[@]}"; then
        local -a norate=() skip=0 a
        for a in "${args[@]}"; do
            if (( skip )); then skip=0; continue; fi
            if [[ $a == --rate ]]; then skip=1; continue; fi
            norate+=("$a")
        done
        xrandr "${norate[@]}" || true
    fi
}

watch() {
    # One watcher per session (exec_always re-runs on reload).
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/dock-monitors.lock"
    flock -n 9 || exit 0

    # i3 runs this in its own process group, so `kill 0` only stops the pipeline.
    trap 'trap - EXIT; kill 0' EXIT

    apply
    udevadm monitor --udev --subsystem-match=drm | while read -r _; do
        # Wait out the burst of events one hotplug fires.
        while read -r -t 1 _; do :; done
        apply
    done &

    # Live only as long as the X server does, or a leftover watcher would hold
    # the lock in the next session.
    while xrandr --current >/dev/null 2>&1; do
        sleep 10
    done
}

case "${1:-}" in
    ''|--apply) apply ;;
    --watch)    watch ;;
    *) printf 'usage: %s [--apply|--watch]\n' "${0##*/}" >&2; exit 1 ;;
esac
