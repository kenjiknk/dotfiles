# ThinkPad E14 Gen 6. Included from the end of ~/.config/i3/config.

# br-thinkpad puts `/ ?` where right Ctrl normally is. The bar's layout block
# switches to us-intl and back.
exec_always --no-startup-id ~/Scripts/kbd-layout set br:thinkpad us:intl

# Off at login and on every restart; $mod+Shift+t turns it on.
exec_always --no-startup-id ~/Scripts/touchpad off

# Dock layout, re-applied on every hotplug.
exec_always --no-startup-id ~/Scripts/dock-monitors --watch
