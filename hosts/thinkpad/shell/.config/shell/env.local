# ThinkPad E14 Gen 6 — machine-specific login environment.
# Sourced from the end of ~/.config/shell/env.

# Sway reads /proc/modules at startup and, if it finds evdi (displaylink) or
# nvidia_drm, puts up a swaynag saying proprietary GPU drivers are unsupported.
# Here it is evdi: the two DisplayLink monitors on the dock depend on it and
# work fine — the rendering is done by the Radeon 680M on the kernel's amdgpu.
# The warning only means "do not report sway bugs in this configuration", so
# the banner is dismissed up front.
export SWAY_UNSUPPORTED_GPU=true
