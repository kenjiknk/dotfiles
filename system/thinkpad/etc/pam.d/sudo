#%PAM-1.0
# Fingerprint first (fprintd, the Goodix reader); after 10 s or two misses it
# falls back to the password. Arch's stock file plus the first line.
# A leading "-" skips the line if pam_fprintd.so is missing, instead of
# failing every sudo.
-auth		sufficient	pam_fprintd.so	max-tries=2 timeout=10
auth		include		system-auth
account		include		system-auth
session		include		system-auth
session		optional	pam_systemd.so class=none
