{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#9fabad", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#839395", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#268bd3", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#001419", "background_color": "#268bd3", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### ", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#0b4250", "format": "\n────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#29a298", "underline": true },
  "link_text": { "color": "#47adf5", "bold": true },
  "image": { "color": "#f254a1", "underline": true },
  "image_text": { "color": "#839395" },
  "code": { "prefix": " ", "suffix": " ", "color": "#f84f0d", "background_color": "#002c38" },
  "code_block": {
    "color": "#839395",
    "margin": 2,
    "chroma": {
      "text": { "color": "#9fabad" },
      "error": { "color": "#9fabad", "background_color": "#f65351" },
      "comment": { "color": "#738a90", "italic": true },
      "comment_preproc": { "color": "#f84f0d" },
      "keyword": { "color": "#f254a1" },
      "keyword_reserved": { "color": "#f254a1" },
      "keyword_namespace": { "color": "#f254a1" },
      "keyword_type": { "color": "#e6ac00" },
      "operator": { "color": "#2bd1c3" },
      "punctuation": { "color": "#839395" },
      "name": { "color": "#9fabad" },
      "name_builtin": { "color": "#f84f0d" },
      "name_tag": { "color": "#f254a1" },
      "name_attribute": { "color": "#e6ac00" },
      "name_class": { "color": "#e6ac00", "bold": true },
      "name_constant": { "color": "#f84f0d" },
      "name_decorator": { "color": "#e6ac00" },
      "name_function": { "color": "#47adf5" },
      "literal_number": { "color": "#f84f0d" },
      "literal_string": { "color": "#b7d300" },
      "literal_string_escape": { "color": "#2bd1c3" },
      "generic_deleted": { "color": "#f65351" },
      "generic_inserted": { "color": "#b7d300" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#738a90" },
      "background": { "background_color": "#002c38" }
    }
  },
  "table": {},
  "definition_description": { "block_prefix": "\n→ " }
}
