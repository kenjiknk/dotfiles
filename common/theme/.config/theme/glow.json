{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#c5c9c5", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#a6a69c", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#8ba4b0", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#181616", "background_color": "#8ba4b0", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### ", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#393836", "format": "\n────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#72a7bc", "underline": true },
  "link_text": { "color": "#7fb4ca", "bold": true },
  "image": { "color": "#938aa9", "underline": true },
  "image_text": { "color": "#a6a69c" },
  "code": { "prefix": " ", "suffix": " ", "color": "#b98d7b", "background_color": "#1d1c19" },
  "code_block": {
    "color": "#a6a69c",
    "margin": 2,
    "chroma": {
      "text": { "color": "#c5c9c5" },
      "error": { "color": "#c5c9c5", "background_color": "#c4746e" },
      "comment": { "color": "#7a8382", "italic": true },
      "comment_preproc": { "color": "#b98d7b" },
      "keyword": { "color": "#938aa9" },
      "keyword_reserved": { "color": "#938aa9" },
      "keyword_namespace": { "color": "#938aa9" },
      "keyword_type": { "color": "#e6c384" },
      "operator": { "color": "#7aa89f" },
      "punctuation": { "color": "#a6a69c" },
      "name": { "color": "#c5c9c5" },
      "name_builtin": { "color": "#b98d7b" },
      "name_tag": { "color": "#938aa9" },
      "name_attribute": { "color": "#e6c384" },
      "name_class": { "color": "#e6c384", "bold": true },
      "name_constant": { "color": "#b98d7b" },
      "name_decorator": { "color": "#e6c384" },
      "name_function": { "color": "#7fb4ca" },
      "literal_number": { "color": "#b98d7b" },
      "literal_string": { "color": "#87a987" },
      "literal_string_escape": { "color": "#7aa89f" },
      "generic_deleted": { "color": "#e46876" },
      "generic_inserted": { "color": "#87a987" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#7a8382" },
      "background": { "background_color": "#1d1c19" }
    }
  },
  "table": {},
  "definition_description": { "block_prefix": "\n→ " }
}
