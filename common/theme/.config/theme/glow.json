{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#e6edf3", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#8b949e", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#2f81f7", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#0d1117", "background_color": "#2f81f7", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### ", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#30363d", "format": "\n────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#58a6ff", "underline": true },
  "link_text": { "color": "#79c0ff", "bold": true },
  "image": { "color": "#d2a8ff", "underline": true },
  "image_text": { "color": "#8b949e" },
  "code": { "prefix": " ", "suffix": " ", "color": "#ffa657", "background_color": "#161b22" },
  "code_block": {
    "color": "#8b949e",
    "margin": 2,
    "chroma": {
      "text": { "color": "#e6edf3" },
      "error": { "color": "#e6edf3", "background_color": "#f85149" },
      "comment": { "color": "#7d8590", "italic": true },
      "comment_preproc": { "color": "#ffa657" },
      "keyword": { "color": "#d2a8ff" },
      "keyword_reserved": { "color": "#d2a8ff" },
      "keyword_namespace": { "color": "#d2a8ff" },
      "keyword_type": { "color": "#e3b341" },
      "operator": { "color": "#56d4dd" },
      "punctuation": { "color": "#8b949e" },
      "name": { "color": "#e6edf3" },
      "name_builtin": { "color": "#ffa657" },
      "name_tag": { "color": "#d2a8ff" },
      "name_attribute": { "color": "#e3b341" },
      "name_class": { "color": "#e3b341", "bold": true },
      "name_constant": { "color": "#ffa657" },
      "name_decorator": { "color": "#e3b341" },
      "name_function": { "color": "#79c0ff" },
      "literal_number": { "color": "#ffa657" },
      "literal_string": { "color": "#56d364" },
      "literal_string_escape": { "color": "#56d4dd" },
      "generic_deleted": { "color": "#ffa198" },
      "generic_inserted": { "color": "#56d364" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#7d8590" },
      "background": { "background_color": "#161b22" }
    }
  },
  "table": {},
  "definition_description": { "block_prefix": "\n→ " }
}
