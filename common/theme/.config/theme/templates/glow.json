{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "{{fg}}", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "{{fg_dim}}", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "{{accent}}", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "{{bg}}", "background_color": "{{accent}}", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### ", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "{{surface2}}", "format": "\n────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "{{url}}", "underline": true },
  "link_text": { "color": "{{blue2}}", "bold": true },
  "image": { "color": "{{magenta2}}", "underline": true },
  "image_text": { "color": "{{fg_dim}}" },
  "code": { "prefix": " ", "suffix": " ", "color": "{{orange2}}", "background_color": "{{bg_soft}}" },
  "code_block": {
    "color": "{{fg_dim}}",
    "margin": 2,
    "chroma": {
      "text": { "color": "{{fg}}" },
      "error": { "color": "{{fg}}", "background_color": "{{error}}" },
      "comment": { "color": "{{muted}}", "italic": true },
      "comment_preproc": { "color": "{{orange2}}" },
      "keyword": { "color": "{{magenta2}}" },
      "keyword_reserved": { "color": "{{magenta2}}" },
      "keyword_namespace": { "color": "{{magenta2}}" },
      "keyword_type": { "color": "{{yellow2}}" },
      "operator": { "color": "{{cyan2}}" },
      "punctuation": { "color": "{{fg_dim}}" },
      "name": { "color": "{{fg}}" },
      "name_builtin": { "color": "{{orange2}}" },
      "name_tag": { "color": "{{magenta2}}" },
      "name_attribute": { "color": "{{yellow2}}" },
      "name_class": { "color": "{{yellow2}}", "bold": true },
      "name_constant": { "color": "{{orange2}}" },
      "name_decorator": { "color": "{{yellow2}}" },
      "name_function": { "color": "{{blue2}}" },
      "literal_number": { "color": "{{orange2}}" },
      "literal_string": { "color": "{{green2}}" },
      "literal_string_escape": { "color": "{{cyan2}}" },
      "generic_deleted": { "color": "{{red2}}" },
      "generic_inserted": { "color": "{{green2}}" },
      "generic_emph": { "italic": true },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "{{muted}}" },
      "background": { "background_color": "{{bg_soft}}" }
    }
  },
  "table": {},
  "definition_description": { "block_prefix": "\n→ " }
}
