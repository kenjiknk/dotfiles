# Generated by ~/Scripts/theme-render from ~/.config/theme/theme.toml
# ({{meta.name}}). Included from zathurarc; edit templates/zathura-colors.

set default-bg "{{bg}}"
set default-fg "{{fg}}"
set recolor-lightcolor "{{bg}}"
set recolor-darkcolor "{{fg}}"

# Search highlights: yellow for every match, aqua for the current one.
set highlight-color "{{yellow}}"
set highlight-active-color "{{cyan}}"
