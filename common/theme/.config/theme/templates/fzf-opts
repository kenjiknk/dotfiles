# Generated by ~/Scripts/theme-render from ~/.config/theme/theme.toml
# ({{meta.name}}). Edit templates/fzf-opts, not this file.
# Read by every fzf through FZF_DEFAULT_OPTS_FILE (~/.config/shell/env), so a
# theme switch reaches the next fzf without reloading the shell.
--color=fg:{{fg_dim}},bg:-1,hl:{{accent}}
--color=fg+:{{fg}},bg+:{{surface}},hl+:{{accent}}
--color=info:{{muted}},prompt:{{accent}},pointer:{{accent}},marker:{{green2}}
--color=spinner:{{accent}},header:{{blue2}},border:{{surface2}},gutter:-1
--color=query:{{fg}},label:{{fg_dim}}
