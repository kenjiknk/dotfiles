# Generated by ~/Scripts/theme-render from ~/.config/theme/theme.toml
# ({{meta.name}}). Edit templates/btop.theme, not this file.
# Selected in ~/.config/btop/btop.conf as color_theme = "desktop".

theme[main_bg]="{{bg}}"
theme[main_fg]="{{fg}}"
theme[title]="{{fg}}"
theme[hi_fg]="{{accent}}"
theme[selected_bg]="{{selection}}"
theme[selected_fg]="{{fg_warm}}"
theme[inactive_fg]="{{overlay}}"
theme[graph_text]="{{fg_dim}}"
theme[meter_bg]="{{surface}}"
theme[proc_misc]="{{accent}}"
theme[cpu_box]="{{surface2}}"
theme[mem_box]="{{surface2}}"
theme[net_box]="{{surface2}}"
theme[proc_box]="{{surface2}}"
theme[div_line]="{{surface2}}"

# Gradients: calm to busy, green to red.
theme[temp_start]="{{green2}}"
theme[temp_mid]="{{yellow2}}"
theme[temp_end]="{{error}}"
theme[cpu_start]="{{cyan2}}"
theme[cpu_mid]="{{yellow2}}"
theme[cpu_end]="{{error}}"
theme[free_start]="{{error}}"
theme[free_mid]="{{yellow2}}"
theme[free_end]="{{green2}}"
theme[cached_start]="{{blue}}"
theme[cached_mid]="{{blue2}}"
theme[cached_end]="{{cyan2}}"
theme[available_start]="{{orange2}}"
theme[available_mid]="{{yellow2}}"
theme[available_end]="{{green2}}"
theme[used_start]="{{cyan2}}"
theme[used_mid]="{{orange2}}"
theme[used_end]="{{error}}"
theme[download_start]="{{green}}"
theme[download_mid]="{{cyan}}"
theme[download_end]="{{green2}}"
theme[upload_start]="{{orange}}"
theme[upload_mid]="{{orange2}}"
theme[upload_end]="{{yellow2}}"
theme[process_start]="{{cyan2}}"
theme[process_mid]="{{orange2}}"
theme[process_end]="{{error}}"
