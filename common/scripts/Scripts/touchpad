#!/usr/bin/env bash
# touchpad [toggle|on|off|status]
#
# Finds touchpads by capability (only they have "libinput Tapping Enabled"), so
# it works on any machine and exits 1 on one without. Every call also applies
# the tuning below; a resume can bring the device back untuned and enabled, and
# $mod+Shift+c (which runs `touchpad off`) fixes both.

set -euo pipefail

usage() {
    printf 'usage: %s [toggle|on|off|status]\n' "${0##*/}" >&2
    exit 1
}

case "${1:-toggle}" in
    toggle|on|off|status) action=${1:-toggle} ;;
    *) usage ;;
esac

touchpads=()
while read -r id; do
    # Disabled devices are listed as "∼ 8".
    id=${id//[!0-9]/}
    [[ -n $id ]] || continue
    if xinput list-props "$id" 2>/dev/null | grep -q 'libinput Tapping Enabled ('; then
        touchpads+=("$id")
    fi
done < <(xinput list --id-only)

if (( ${#touchpads[@]} == 0 )); then
    printf '%s: no touchpad found\n' "${0##*/}" >&2
    exit 1
fi

enabled() {
    xinput list-props "$1" | sed -n 's/^\s*Device Enabled ([0-9]*):\s*//p'
}

# Properties a touchpad lacks are skipped.
tune() {
    local id=$1
    xinput set-prop "$id" 'libinput Tapping Enabled' 1 2>/dev/null || true
    xinput set-prop "$id" 'libinput Natural Scrolling Enabled' 1 2>/dev/null || true
    xinput set-prop "$id" 'libinput Disable While Typing Enabled' 1 2>/dev/null || true
    xinput set-prop "$id" 'libinput Middle Emulation Enabled' 1 2>/dev/null || true
    # two-finger, edge, on-button-down
    xinput set-prop "$id" 'libinput Scroll Method Enabled' 1 0 0 2>/dev/null || true
    # button areas, clickfinger
    xinput set-prop "$id" 'libinput Click Method Enabled' 0 1 2>/dev/null || true
}

current=$(enabled "${touchpads[0]}")

if [[ $action == status ]]; then
    if [[ $current == 1 ]]; then echo enabled; else echo disabled; fi
    exit 0
fi

want=$action
if [[ $want == toggle ]]; then
    if [[ $current == 1 ]]; then want=off; else want=on; fi
fi

for id in "${touchpads[@]}"; do
    tune "$id"
    if [[ $want == on ]]; then xinput enable "$id"; else xinput disable "$id"; fi
done

# Notify on toggle only, so the `off` at every restart stays silent.
if [[ $action == toggle ]] && command -v notify-send >/dev/null; then
    notify-send -a "touchpad" -t 1500 "Touchpad" "$want"
fi
