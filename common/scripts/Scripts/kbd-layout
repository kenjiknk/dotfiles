#!/usr/bin/env bash
# Keyboard layouts under X, with nothing but setxkbmap.
#
#   kbd-layout set br:thinkpad us:intl   the layouts, first one active
#   kbd-layout next                      rotate: the second becomes the first
#   kbd-layout current                   print the active layout (for the bar)
#
# `next` rotates the whole list instead of switching XKB groups. The layout in
# front is then always the one in use, so `setxkbmap -query` alone answers
# "which layout is active" — no xkb-switch or other extra tool, which is what
# keeps this working on any distro.
#
# Each LAYOUT:VARIANT pair may leave the variant out (`us` = plain us).

set -euo pipefail

refresh_bar() { pkill -RTMIN+10 -x i3blocks 2>/dev/null || true; }

# setxkbmap -query prints e.g. "layout:     br,us" and "variant:    thinkpad,intl".
query() { setxkbmap -query | sed -n "s/^$1: *//p"; }

apply() {
    local layouts=() variants=() pair
    for pair in "$@"; do
        layouts+=("${pair%%:*}")
        if [[ $pair == *:* ]]; then variants+=("${pair#*:}"); else variants+=(""); fi
    done
    local IFS=,
    setxkbmap -layout "${layouts[*]}" -variant "${variants[*]}"
    refresh_bar
}

case "${1:-}" in
    set)
        shift
        (( $# )) || { printf '%s: set needs at least one LAYOUT[:VARIANT]\n' "${0##*/}" >&2; exit 1; }
        apply "$@"
        ;;
    next)
        IFS=, read -r -a layouts <<<"$(query layout)"
        IFS=, read -r -a variants <<<"$(query variant)"
        (( ${#layouts[@]} > 1 )) || exit 0
        pairs=()
        for i in "${!layouts[@]}"; do
            pairs+=("${layouts[i]}:${variants[i]:-}")
        done
        apply "${pairs[@]:1}" "${pairs[0]}"
        ;;
    current)
        layout=$(query layout)
        printf '%s\n' "${layout%%,*}"
        ;;
    *)
        printf 'usage: %s set LAYOUT[:VARIANT]... | next | current\n' "${0##*/}" >&2
        exit 1
        ;;
esac
