#!/usr/bin/env bash
# Keyboard layouts with nothing but setxkbmap.
#
#   kbd-layout set br:thinkpad us:intl   set the layouts, first one active
#   kbd-layout next                      rotate the list: the second becomes first
#   kbd-layout reapply                   set the current layouts again
#   kbd-layout current                   print the active layout
#
# Rotating the list (rather than switching XKB groups) keeps the active layout
# first, so `setxkbmap -query` is all it takes to read it back.

set -euo pipefail

# Tell the bar (Quickshell) to read the layout again; quiet when it is not running.
refresh_bar() { qs ipc call keyboard refresh >/dev/null 2>&1 || true; }

query() { setxkbmap -query | sed -n "s/^$1: *//p"; }

apply() {
    local layouts=() variants=() pair
    for pair in "$@"; do
        layouts+=("${pair%%:*}")
        if [[ $pair == *:* ]]; then variants+=("${pair#*:}"); else variants+=(""); fi
    done
    local IFS=,
    setxkbmap -layout "${layouts[*]}" -variant "${variants[*]}"
    refresh_bar
}

case "${1:-}" in
    set)
        shift
        (( $# )) || { printf '%s: set needs at least one LAYOUT[:VARIANT]\n' "${0##*/}" >&2; exit 1; }
        apply "$@"
        ;;
    next)
        IFS=, read -r -a layouts <<<"$(query layout)"
        IFS=, read -r -a variants <<<"$(query variant)"
        (( ${#layouts[@]} > 1 )) || exit 0
        pairs=()
        for i in "${!layouts[@]}"; do
            pairs+=("${layouts[i]}:${variants[i]:-}")
        done
        apply "${pairs[@]:1}" "${pairs[0]}"
        ;;
    reapply)
        layout=$(query layout)
        [[ -n $layout ]] || exit 0
        setxkbmap -layout "$layout" -variant "$(query variant)"
        ;;
    current)
        layout=$(query layout)
        printf '%s\n' "${layout%%,*}"
        ;;
    *)
        printf 'usage: %s set LAYOUT[:VARIANT]... | next | reapply | current\n' "${0##*/}" >&2
        exit 1
        ;;
esac
