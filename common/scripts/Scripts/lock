#!/usr/bin/env bash
# lock — the lock screen. Run by xss-lock (idle, before suspend,
# `loginctl lock-session`); lock by hand with that loginctl command, as the
# power menu does, so xss-lock never stacks a second one.
#
# Plain i3lock on pure black (pixels off on an OLED panel), with its stock
# ring indicator while typing, failed attempts counted and the keyboard layout
# shown (a password typed in br instead of us fails for no visible reason).
#
# While locked: notifications are paused, since dunst draws above other windows
# and would show them to anyone looking, and media players are paused.
# Notifications come back on unlock (unless they were paused before); music
# stays paused.

set -u

opts=(--color=000000 --ignore-empty-password --show-failed-attempts
    --show-keyboard-layout)

# Before locking: hold notifications back and pause music. Each step is
# skipped quietly when its tool is missing.
was_paused=false
if command -v dunstctl >/dev/null; then
    [[ $(dunstctl is-paused 2>/dev/null) == true ]] && was_paused=true
    dunstctl set-paused true 2>/dev/null
fi
command -v playerctl >/dev/null && playerctl --all-players pause 2>/dev/null

# After unlocking (or if this script is killed): notifications back.
resume() {
    if [[ $was_paused == false ]] && command -v dunstctl >/dev/null; then
        dunstctl set-paused false 2>/dev/null
    fi
}
trap resume EXIT

if [[ -e /dev/fd/${XSS_SLEEP_LOCK_FD:--1} ]]; then
    # Before suspend xss-lock passes a sleep-delay lock as XSS_SLEEP_LOCK_FD,
    # and logind suspends once every copy is closed. i3lock never closes one
    # it inherits, so it gets none; forking, it returns once the screen is
    # locked, and closing this script's copy then lets the suspend proceed.
    # (xss-lock's own transfer-sleep-lock-i3lock.sh does the same.)
    i3pid() { pgrep -xnu "$EUID" i3lock; }
    trap 'pkill -xu "$EUID" i3lock' TERM INT
    i3lock "${opts[@]}" {XSS_SLEEP_LOCK_FD}<&-
    exec {XSS_SLEEP_LOCK_FD}<&-
    pid=$(i3pid)
    while [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; do sleep 0.5; done
else
    trap 'kill %% 2>/dev/null' TERM INT
    i3lock --nofork "${opts[@]}" &
    wait
fi
