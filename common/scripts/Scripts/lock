#!/usr/bin/env bash
# lock — the lock screen. Run by xss-lock (idle, before suspend,
# `loginctl lock-session`); lock by hand with that loginctl command, as the
# power menu does, so xss-lock never stacks a second one.
#
# xsecurelock on pure black (pixels off on an OLED panel). Any key brings up
# a centred prompt in the palette's colours: date and time, user@host, the
# keyboard layout (a password typed in br instead of us fails for no visible
# reason) and a cursor that jumps on each key, so the password length never
# shows. The prompt shifts a little each time and goes back to black after 30 s
# without typing, so nothing stays lit in one place.
#
# While locked: notifications are paused, since dunst draws above other windows
# and would show them to anyone looking, and media players are paused.
# Notifications come back on unlock (unless they were paused before); music
# stays paused.
#
# Without xsecurelock, plain i3lock on black with the same layout and
# failed-attempt display: the screen always locks.

set -u

colors=${XDG_CONFIG_HOME:-$HOME/.config}/theme/colors.sh
fg='#c5c9c5'
red='#c4746e'
# shellcheck source=/dev/null
[[ -r $colors ]] && . "$colors"

export XSECURELOCK_BACKGROUND_COLOR='#000000'
export XSECURELOCK_AUTH_BACKGROUND_COLOR='#000000'
export XSECURELOCK_AUTH_FOREGROUND_COLOR=$fg
export XSECURELOCK_AUTH_WARNING_COLOR=$red
export XSECURELOCK_FONT='JetBrainsMono Nerd Font:size=13'
export XSECURELOCK_SHOW_DATETIME=1
export XSECURELOCK_DATETIME_FORMAT='%A, %d %B  %H:%M'
export XSECURELOCK_SHOW_USERNAME=1
export XSECURELOCK_SHOW_HOSTNAME=1
export XSECURELOCK_SHOW_KEYBOARD_LAYOUT=1
export XSECURELOCK_PASSWORD_PROMPT=cursor
export XSECURELOCK_AUTH_CURSOR_BLINK=0
export XSECURELOCK_AUTH_TIMEOUT=30
export XSECURELOCK_BURNIN_MITIGATION=100
export XSECURELOCK_SINGLE_AUTH_WINDOW=1

lock_now() {
    if command -v xsecurelock >/dev/null; then
        xsecurelock
    else
        i3lock --nofork --color 000000 \
            --ignore-empty-password --show-failed-attempts --show-keyboard-layout
    fi
}

# Before locking: hold notifications back and pause music. Each step is
# skipped quietly when its tool is missing.
was_paused=false
if command -v dunstctl >/dev/null; then
    [[ $(dunstctl is-paused 2>/dev/null) == true ]] && was_paused=true
    dunstctl set-paused true 2>/dev/null
fi
command -v playerctl >/dev/null && playerctl --all-players pause 2>/dev/null

# After unlocking (or if this script is killed): notifications back.
resume() {
    if [[ $was_paused == false ]] && command -v dunstctl >/dev/null; then
        dunstctl set-paused false 2>/dev/null
    fi
}
trap resume EXIT
trap 'kill %% 2>/dev/null' TERM INT

# Before suspend xss-lock passes a sleep-delay lock as XSS_SLEEP_LOCK_FD.
# xsecurelock (and i3lock) inherit it and close it once the screen is locked;
# this script drops its own copy so logind lets the suspend proceed then.
lock_now &
if [[ -e /dev/fd/${XSS_SLEEP_LOCK_FD:--1} ]]; then
    exec {XSS_SLEEP_LOCK_FD}<&-
fi
wait
