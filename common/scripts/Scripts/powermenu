#!/usr/bin/env bash
# Session power menu for i3, driven by rofi.

set -euo pipefail

choice=$(printf '%s\n' Lock Suspend Logout Reboot Shutdown |
    rofi -dmenu -i -p "power") || exit 0

case "$choice" in
    # xss-lock (started by the i3 config) answers lock-session with i3lock, and
    # never stacks a second one on top of a running lock.
    Lock)     loginctl lock-session ;;
    Suspend)  systemctl suspend ;;
    Logout)   i3-msg exit ;;
    Reboot)   systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
    "")       exit 0 ;;
    *)        printf 'unknown choice: %s\n' "$choice" >&2; exit 1 ;;
esac
