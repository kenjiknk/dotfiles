#!/usr/bin/env bash
# Session menu: lock, suspend, logout, reboot, shutdown.

set -euo pipefail

choice=$(printf '%s\n' Lock Suspend Logout Reboot Shutdown |
    rofi -dmenu -i -p "power") || exit 0

case "$choice" in
    # xss-lock answers with i3lock, never stacking a second one.
    Lock)     loginctl lock-session ;;
    Suspend)  systemctl suspend ;;
    Logout)   i3-msg exit ;;
    Reboot)   systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
    "")       exit 0 ;;
    *)        printf 'unknown choice: %s\n' "$choice" >&2; exit 1 ;;
esac
