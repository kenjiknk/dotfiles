#!/usr/bin/env bash
# Drag a region (across monitors too) and copy it to the clipboard as PNG.
# A temp file instead of a pipe: a cancelled selection must not blank the clipboard.

set -euo pipefail

shot=$(mktemp --suffix=.png)
trap 'rm -f "$shot"' EXIT

maim --select --hidecursor "$shot" || exit 0

xclip -selection clipboard -t image/png -i "$shot"
