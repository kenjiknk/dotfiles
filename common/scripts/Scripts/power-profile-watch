#!/bin/sh
# power-profile-watch — refreshes the bar's power-profile block the moment the
# profile changes, whatever changed it: the rofi menu, Fn+L/M/H, powerprofilesctl,
# the charger. Watches power-profiles-daemon on D-Bus and sends the block's
# signal (signal=9 in ~/.config/i3blocks/config); the block's 10 s interval is
# then only a fallback. Started from i3, one copy (flock).

while :; do
    gdbus monitor --system --dest net.hadess.PowerProfiles \
        --object-path /net/hadess/PowerProfiles 2>/dev/null |
        while read -r line; do
            case $line in
                *ActiveProfile*) pkill -RTMIN+9 -x i3blocks 2>/dev/null ;;
            esac
        done
    # gdbus exits if the daemon or the bus goes away; try again.
    sleep 5
done
