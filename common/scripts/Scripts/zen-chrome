#!/usr/bin/env bash
# zen-chrome — points Zen Browser's default profile at the palette-coloured
# userChrome.css (~/.config/theme/zen/userChrome.css) and turns on the pref
# that makes Zen read it. Profiles have random names, so this finds the one in
# use instead of the repo tracking a path. Idempotent; quiet without Zen.
# Restart Zen afterwards.

set -euo pipefail

zen=${XDG_CONFIG_HOME:-$HOME/.config}/zen
css=${XDG_CONFIG_HOME:-$HOME/.config}/theme/zen/userChrome.css
pref='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'

[[ -r $zen/profiles.ini && -r $css ]] || exit 0

# The profile this installation launches with: Default= under profiles.ini's
# [Install<hash>] section (installs.ini names the same section without the
# prefix, so it cannot be told apart from a profile section there).
profile=$(sed -n '/^\[Install/,/^\[/s/^Default=//p' "$zen/profiles.ini" | head -n 1)
[[ -n $profile && -d $zen/$profile ]] || { echo "zen-chrome: no default profile" >&2; exit 1; }
dir=$zen/$profile

mkdir -p "$dir/chrome"
target=$dir/chrome/userChrome.css
if [[ -e $target && ! -L $target ]]; then
    echo "zen-chrome: $target is a real file; move it aside first" >&2
    exit 1
fi
ln -sfn "$css" "$target"

touch "$dir/user.js"
grep -qxF "$pref" "$dir/user.js" || printf '%s\n' "$pref" >> "$dir/user.js"

echo "linked $target"
