#!/usr/bin/env bash
# Current power profile; the two extremes are coloured. Click: the menu.
# Hidden without power-profiles-daemon.

[[ ${BLOCK_BUTTON:-} == 1 ]] && setsid -f ~/Scripts/power-profile-menu >/dev/null 2>&1

command -v powerprofilesctl >/dev/null || exit 0

# Palette ($red, $yellow), generated from ~/.config/theme/theme.toml. Without it
# the states just go uncoloured.
# shellcheck source=/dev/null
. "${XDG_CONFIG_HOME:-$HOME/.config}/theme/colors.sh" 2>/dev/null
profile=$(powerprofilesctl get 2>/dev/null) || exit 0

case "$profile" in
    power-saver) label="eco";  color="${yellow:-}" ;;
    balanced)    label="bal";  color="" ;;
    performance) label="perf"; color="${red:-}" ;;
    *)           label="$profile"; color="" ;;
esac

echo "pwr $label"
echo "pwr $label"
[[ -n $color ]] && echo "$color"
exit 0
