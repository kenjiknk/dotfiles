#!/usr/bin/env bash
# Now playing, via playerctl: "artist • title", dimmed while paused.
# Left click: play/pause. Empty when nothing is playing.

[[ ${BLOCK_BUTTON:-} == 1 ]] && playerctl play-pause 2>/dev/null

command -v playerctl >/dev/null || exit 0
status=$(playerctl status 2>/dev/null) || exit 0
[[ $status == Stopped ]] && exit 0

text=$(playerctl metadata --format '{{artist}} • {{title}}' 2>/dev/null) || exit 0
(( ${#text} > 55 )) && text="${text:0:54}…"

echo "$text"
echo "$text"
[[ $status == Paused ]] && echo "#505050"
exit 0
