# Status line for i3bar. Each block is ~/.config/i3blocks/blocks/<name> and
# prints nothing when the machine lacks what it shows, so one config fits all.
# Output: line 1 text, line 3 (optional) colour.
#
# Signals, sent by scripts with `pkill -RTMIN+N -x i3blocks` for an instant
# refresh: 9 power-profile, 10 layout, 11 volume.

command=$HOME/.config/i3blocks/blocks/$BLOCK_NAME
separator=false
separator_block_width=14

[last-updated]
interval=3600

[cpu]
interval=2

[memory]
interval=2

[disk]
interval=30

[network]
interval=5

[bluetooth]
interval=10

[volume]
interval=5
signal=11

[layout]
interval=once
signal=10

[power-profile]
interval=10
signal=9

[battery]
interval=5

[clock]
interval=5
markup=pango
