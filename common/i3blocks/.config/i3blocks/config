# i3blocks: the status line of i3bar. One config for every machine — each block
# prints nothing when the machine lacks what it reports (no battery, no
# power-profiles-daemon, no pacman), and i3bar then leaves it out.
#
# Every block is a script in ~/.config/i3blocks/blocks named after it. Plain
# output: first line is the text, third line (when present) the colour.
#
# `signal` lets a script elsewhere refresh a block at once with
# `pkill -RTMIN+N -x i3blocks`:
#    9  power-profile   ~/Scripts/power-profile-menu
#   10  layout          ~/Scripts/kbd-layout
#   11  volume          ~/Scripts/volume

command=$HOME/.config/i3blocks/blocks/$BLOCK_NAME
separator=false
separator_block_width=14

[mpris]
interval=3

[last-updated]
interval=3600

[cpu]
interval=2

[memory]
interval=2

[disk]
interval=30

[network]
interval=5

[volume]
interval=5
signal=11

[layout]
interval=once
signal=10

[power-profile]
interval=10
signal=9

[battery]
interval=5

[clock]
interval=5
