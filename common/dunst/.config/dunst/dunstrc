# Notifications: Kanagawa Dragon card, top-right, newest first, ten seconds each.
# Needs dunst 1.7+ for the geometry keys.

[global]
    origin = top-right
    offset = 10x10
    width = 320
    height = 100
    notification_limit = 0

    frame_width = 0
    corner_radius = 4
    padding = 10
    horizontal_padding = 10
    gap_size = 6

    font = Inter 11
    markup = full
    alignment = left
    word_wrap = yes
    ellipsize = end

    icon_position = left
    max_icon_size = 64

    # Newest on top (dunst 1.11+; older ones fall back to their default).
    sort = update
    stack_duplicates = true
    history_length = 10

    background = "#0d0c0cee"
    foreground = "#c5c9c5"
    frame_color = "#393836"

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# Same timeout for every urgency, whatever the sender asks for.
[urgency_low]
    timeout = 10

[urgency_normal]
    timeout = 10

[urgency_critical]
    timeout = 10
    foreground = "#c4746e"
