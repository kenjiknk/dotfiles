# Generated by ~/Scripts/theme-render from ~/.config/theme/theme.toml
# (kanagawa-dragon). Edit templates/dunstrc, not this file: the whole dunstrc is
# a template because dunst only gained drop-in files (dunstrc.d) in 1.10.
#
# Notifications: a palette card, top-right, newest first, ten seconds each.
# Needs dunst 1.7+ for the geometry keys.

[global]
    # Below the 20 px bar plus the usual 8: dunst offsets from the screen
    # edge, not from i3's dock area, so a plain 8x8 covers the bar.
    origin = top-right
    offset = 8x28
    # Fit the content, up to 320 px: the volume and brightness bars stay
    # small, long notifications wrap at the same width as before.
    width = (0, 320)
    height = 100
    notification_limit = 0

    # Same 4 px radius as rofi and (through picom) the windows.
    frame_width = 0
    corner_radius = 4
    padding = 8
    horizontal_padding = 12
    gap_size = 8

    font = Inter 11
    markup = full
    alignment = left
    word_wrap = yes
    ellipsize = end

    icon_position = left
    max_icon_size = 64
    # Same icons as GTK; recursive lookup finds Papirus' symbolic ones.
    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true

    # Newest on top (dunst 1.11+; older ones fall back to their default).
    sort = update
    stack_duplicates = true
    history_length = 10

    # Panels share bg_alt with the bar and rofi; "ee" is the alpha.
    background = "#12120fee"
    foreground = "#c5c9c5"
    frame_color = "#393836"
    # Progress bars (volume and brightness, ~/Scripts/osd) in the accent.
    highlight = "#8ba4b0"
    progress_bar_height = 4
    progress_bar_min_width = 120
    progress_bar_max_width = 120
    # A 1 px frame in frame_color (surface2) shows the empty part of the
    # track; without it 30% reads as a short bar instead of a third-full one.
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 4

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# Same timeout for every urgency, whatever the sender asks for.
[urgency_low]
    timeout = 10

[urgency_normal]
    timeout = 10

[urgency_critical]
    timeout = 10
    foreground = "#c4746e"

# On-screen bars from ~/Scripts/osd: gone in under two seconds, and not worth
# keeping in the history.
[osd]
    appname = osd
    # Just the icon and the number, small.
    format = "%s"
    max_icon_size = 16
    timeout = 1500ms
    history_ignore = yes
