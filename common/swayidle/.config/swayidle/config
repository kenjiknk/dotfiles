# swayidle configuration file
# Idle timeout events for Sway

# `pidof -q swaylock || swaylock -f` everywhere instead of a bare `swaylock -f`:
# swaylock has no single-instance guard, so suspending an already-locked
# session would stack a second lock surface and you would have to type the
# password twice to get back in. ~/Scripts/powermenu does the same.

# Lock screen after 5 minutes (300 seconds) of inactivity
timeout 300 'pidof -q swaylock || swaylock -f'

# Screen off after 5.5 minutes (330 seconds) of inactivity.
# `power`, not `dpms`: man 5 sway-output calls dpms a deprecated alias for it.
#
# Waking goes through ~/Scripts/wake-outputs rather than a bare `output * power
# on`, because that command reports success while silently leaving the
# DisplayLink screens off; the script re-issues it until sway agrees every
# active output is really on. Its header has the details.
timeout 330 'swaymsg "output * power off"' resume '~/Scripts/wake-outputs'

# Lock session before sleep
before-sleep 'pidof -q swaylock || swaylock -f'

# Lock on request, e.g. `loginctl lock-session`. Without this the timeout above
# is the only thing that ever locks the screen.
lock 'pidof -q swaylock || swaylock -f'
