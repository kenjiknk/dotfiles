# Generated by ~/Scripts/theme-render from ~/.config/theme/theme.toml
# (gruvbox-dark). Edit templates/i3-colors, not this file.
#
# Window colours and the whole bar block live here, not in ~/.config/i3/config:
# i3 does not carry `set $var` from an included file back to the file that
# includes it, so the colours have to be written out where they are used.

# The accent marks focus, here and on the bar's current workspace.
# Columns: border, background, text, indicator, child_border.
client.focused          #d79921 #3c3836 #ebdbb2 #d79921 #d79921
client.focused_inactive #504945 #32302f #a89984 #504945 #504945
client.unfocused        #3c3836 #282828 #928374 #3c3836 #3c3836
client.urgent           #fb4934 #fb4934 #1d2021 #fb4934 #fb4934

# i3bar draws workspaces and the tray; the status line is i3blocks
# (~/.config/i3blocks/config).
bar {
    status_command i3blocks
    position top
    font pango:Inter SemiBold 8
    separator_symbol " "
    tray_padding 2

    colors {
        background #1d2021
        statusline #ebdbb2
        separator  #1d2021

        # Current workspace in the accent, like the focused window's border;
        # the one visible on another screen in surface2; the rest dimmed.
        # Columns: border, background, text.
        focused_workspace  #d79921 #d79921 #1d2021
        active_workspace   #504945 #504945 #ebdbb2
        inactive_workspace #1d2021 #1d2021 #a89984
        urgent_workspace   #fb4934 #fb4934 #1d2021
        binding_mode       #504945 #504945 #ebdbb2
    }
}
