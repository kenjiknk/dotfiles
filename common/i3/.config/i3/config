# Portable i3 configuration. Machine-specific settings (keyboard layout,
# touchpad, monitors) live in ~/.config/i3/local, included at the end.
#
# Targets i3 4.22+ (built-in gaps); older i3 loads it minus the gaps lines.
# i3 splits binding commands on `,` and `;`, so anything that needs a shell
# pipeline lives in ~/Scripts.

### Variables

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $menu rofi -show drun

### Appearance

# libadwaita apps read dark mode from gsettings through the settings portal.
exec_always --no-startup-id gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

default_border pixel 2
default_floating_border pixel 2

#               border  background  text     indicator child_border
client.focused          #0080ff #404552 #f7fafc #0080ff #0080ff
client.focused_inactive #3a3a3a #1e1e1e #a0a0a0 #3a3a3a #3a3a3a
client.unfocused        #1a1a1a #121212 #505050 #1a1a1a #1a1a1a
client.urgent           #6b3a3a #6b3a3a #d0d0d0 #6b3a3a #6b3a3a

gaps inner 5
smart_gaps on
hide_edge_borders smart

# Used by the titles of tabbed and stacked containers.
font pango:DejaVu Sans Mono 9

# kitty (hide_window_decorations) and others ask for no decorations through the
# Motif hints, which i3 honours by dropping the border. Put it back.
for_window [class=".*"] border pixel 2

workspace_auto_back_and_forth yes
focus_wrapping no

### Autostart
#
# Optional programs fail quietly when missing; the session carries on.

# A different random wallpaper on every login and restart.
exec_always --no-startup-id ~/Scripts/wallpaper

# Repeat rate, re-applied with the layouts to keyboards plugged in later.
exec_always --no-startup-id ~/Scripts/keyboard-watch

exec --no-startup-id dunst

# Lock at 300 s (screen saver -> xss-lock -> i3lock), screens off at 330 s.
# xss-lock also locks before suspend and on `loginctl lock-session`.
exec_always --no-startup-id xset s 300 +dpms dpms 0 0 330
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork --color 000000

exec --no-startup-id picom
exec --no-startup-id nm-applet

# Hide the pointer while typing and after 8 s idle.
exec --no-startup-id xbanish -t 8

# Spiral tiling. exec_always because a restart drops its IPC connection; the
# lock keeps a copy that outlives it from doubling up.
exec_always --no-startup-id flock -n "$XDG_RUNTIME_DIR/autotiling.lock" autotiling

### Key bindings

bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+Shift+f exec $term -e yazi
bindsym $mod+Shift+e exec --no-startup-id ~/Scripts/powermenu

# Restart, not reload: i3 runs exec_always lines (wallpaper, touchpad off,
# keyboard settings) only on restart. Windows and layout are kept.
bindsym $mod+Shift+c restart

floating_modifier $mod

# Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode "resize" {
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Hardware keys
bindsym XF86AudioMute exec --no-startup-id ~/Scripts/volume mute
bindsym XF86AudioLowerVolume exec --no-startup-id ~/Scripts/volume down
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/Scripts/volume up
bindsym XF86AudioMicMute exec --no-startup-id ~/Scripts/volume mic-mute
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioStop exec --no-startup-id playerctl stop
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+
bindsym XF86TouchpadToggle exec --no-startup-id ~/Scripts/touchpad

# Utilities
bindsym $mod+Shift+s exec --no-startup-id ~/Scripts/screenshot
bindsym $mod+Shift+t exec --no-startup-id ~/Scripts/touchpad
bindsym $mod+Shift+b exec --no-startup-id ~/Scripts/power-profile-menu

### Bar
#
# i3bar draws workspaces and the tray; the status line is i3blocks
# (~/.config/i3blocks/config).

bar {
    status_command i3blocks
    position top
    font pango:Inter SemiBold 8
    separator_symbol " "
    tray_padding 2

    colors {
        background #121212
        statusline #d0d0d0
        separator  #121212

        #                  border  background text
        focused_workspace  #333333 #333333    #d0d0d0
        active_workspace   #121212 #121212    #d0d0d0
        inactive_workspace #121212 #121212    #d0d0d0
        urgent_workspace   #6b3a3a #6b3a3a    #d0d0d0
        binding_mode       #333333 #333333    #d0d0d0
    }
}

# From hosts/<hostname>/i3/; a missing file is fine.
include ~/.config/i3/local
