# Window and scrolling
set scroll-step 50
set statusbar-home-tilde true
set selection-clipboard clipboard
set font "monospace 14"

# Open pages fit-to-width automatically
set pages-per-row 1
set adjust-open "width"

# Dark mode. `recolor` maps the page's own black-on-white to the two colours
# below; keephue false so coloured figures are inverted along with the text.
set recolor "true"
set recolor-keephue "false"

# Kanagawa Dragon, like the rest of the desktop.
set default-bg "#181616"
set default-fg "#c5c9c5"
set recolor-lightcolor "#181616"
set recolor-darkcolor "#c5c9c5"

# Search highlights: yellow for every match, aqua for the current one.
set highlight-color "#c4b28a"
set highlight-active-color "#8ea4a2"
