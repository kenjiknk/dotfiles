# Window and scrolling
set scroll-step 50
set statusbar-home-tilde true
set selection-clipboard clipboard
# 11 pt, the size of the other content text (GTK, dunst, kitty).
set font "monospace 11"

# Open pages fit-to-width automatically
set pages-per-row 1
set adjust-open "width"

# Dark mode. `recolor` maps the page's own black-on-white to the two colours
# below; keephue false so coloured figures are inverted along with the text.
set recolor "true"
set recolor-keephue "false"

# Page, recolor and highlight colours, generated from
# ~/.config/theme/theme.toml. Relative to this file.
include colors
