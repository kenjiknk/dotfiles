# Window and scrolling
set scroll-step 50
set statusbar-home-tilde true
set selection-clipboard clipboard
set font "monospace 14"

# Open pages fit-to-width automatically
set pages-per-row 1
set adjust-open "width"

# Dark mode. `recolor` maps the page's own black-on-white to the two colours
# below; keephue false so coloured figures are inverted along with the text.
set recolor "true"
set recolor-keephue "false"

# Neutral greys like the rest of the desktop: #0d0d0d is the background of
# dunst and rofi.
set default-bg "#0d0d0d"
set default-fg "#c0c0c0"
set recolor-lightcolor "#0d0d0d"
set recolor-darkcolor "#c0c0c0"

# Search highlights, from the terminal palette: muted for every match, pale
# cyan for the one the cursor is on.
set highlight-color "#8c7f70"
set highlight-active-color "#a7c7c7"
