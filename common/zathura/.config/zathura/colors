# Generated by ~/Scripts/theme-render from ~/.config/theme/theme.toml
# (github-dark). Included from zathurarc; edit templates/zathura-colors.

set default-bg "#0d1117"
set default-fg "#e6edf3"
set recolor-lightcolor "#0d1117"
set recolor-darkcolor "#e6edf3"

# Search highlights: yellow for every match, aqua for the current one.
set highlight-color "#d29922"
set highlight-active-color "#39c5cf"
