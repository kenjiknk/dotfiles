# Generated by ~/Scripts/theme-render from ~/.config/theme/theme.toml
# (gruvbox-dark). Included from zathurarc; edit templates/zathura-colors.

set default-bg "#282828"
set default-fg "#ebdbb2"
set recolor-lightcolor "#282828"
set recolor-darkcolor "#ebdbb2"

# Search highlights: yellow for every match, aqua for the current one.
set highlight-color "#d79921"
set highlight-active-color "#689d6a"
