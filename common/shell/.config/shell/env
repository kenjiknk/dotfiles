# Login-time environment, shared by zsh (~/.zprofile) and bash (~/.bash_profile).
#
# This has to be here rather than in ~/.zshrc: that file is only read by
# interactive shells, so nothing the window manager launches — the bar, rofi, a
# keybinding, an xdg-open handler — would ever see these. The login shell is the
# parent of the whole graphical session, so what is exported here reaches all of
# it by inheritance.
#
# Keep it POSIX sh: both shells source it.

# eza, bat and friends live here when installed with --user or pipx.
# Guarded because a login shell can be re-entered (su -l, a nested login), and
# an unguarded prepend grows PATH a copy at a time.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

export EDITOR=nvim
export VISUAL=nvim
export BROWSER=zen-browser

# Makes Qt programs follow the system GTK theme —
# adw-gtk3 recoloured with the palette (~/.config/gtk-3.0/gtk.css), Papirus
# icons, Inter, and the GTK file dialogs — instead of Qt's light default. The
# plugin ships in qt6-base (/usr/lib/qt6/plugins/platformthemes/libqgtk3.so);
# nothing extra to install, and no second colour file to keep in step.
export QT_QPA_PLATFORMTHEME=gtk3

# nmtui (and anything else on newt) defaults to a light blue-and-grey scheme.
# Named ANSI colours, so kitty turns them into the palette: windows on black
# (dragonBlack0), the accent (blue) for titles and the selection, the
# terminal's own background behind.
export NEWT_COLORS='root=white,default;roottext=gray,default;helpline=gray,default;window=white,black;border=gray,black;shadow=,default;title=blue,black;label=white,black;textbox=white,black;acttextbox=black,blue;button=white,black;actbutton=black,blue;compactbutton=white,black;checkbox=white,black;actcheckbox=black,blue;entry=white,black;disentry=gray,black;listbox=white,black;actlistbox=black,blue;sellistbox=blue,black;actsellistbox=black,blue;emptyscale=,black;fullscale=,blue'

# Under X nothing sets the cursor for every client; without these it differs
# per toolkit and comes out small.
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# Per-machine additions, deployed from hosts/<hostname>/shell/. Same idea as
# ~/.config/i3/local: absent on a machine that has none, and sourced last so
# it can override anything above.
[ -r "$HOME/.config/shell/env.local" ] && . "$HOME/.config/shell/env.local"
