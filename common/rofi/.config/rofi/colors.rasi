/* Generated by ~/Scripts/theme-render from ~/.config/theme/theme.toml
 * (gruvbox-dark). Edit the palette or templates/rofi-colors.rasi. */

* {
    bg-alt:    #1d2021;
    fg:        #ebdbb2;
    fg-dim:    #a89984;
    fg-warm:   #d5c4a1;
    accent:    #d79921;
    selection: #504945;

    /* rofi takes @references only as a whole value, never inside one, so
     * `highlight: bold @yellow` is a parse error: the full value lives here. */
    match-highlight: bold #d79921;
}
