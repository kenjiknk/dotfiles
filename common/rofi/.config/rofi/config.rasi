/* Launcher ($mod+d) and the menus in ~/Scripts, in the desktop's palette.
 * rofi 1.7+ syntax. */

configuration {
    modi: "drun,run";
    show-icons: true;
    terminal: "kitty";
    matching: "fuzzy";
    drun-display-format: "{name}";
    display-drun: ">";
    display-run: "run";

    /* Ctrl+j/k move through the list. Their default bindings are cleared
     * first: rofi refuses to start when a key is bound twice. */
    kb-accept-entry: "Return,KP_Enter";
    kb-remove-to-eol: "";
    kb-row-up: "Up,Control+p,Control+k";
    kb-row-down: "Down,Control+n,Control+j";
}

/* Empty base theme: the built-in one colours list rows itself, overriding `*`. */
@theme "/dev/null"

/* @bg-alt, @fg, @accent, ...: generated from ~/.config/theme/theme.toml.
 * After @theme, which discards whatever came before it. */
@import "colors.rasi"

* {
    background-color: @bg-alt;
    text-color: @fg-dim;
    font: "JetBrainsMono Nerd Font 10";
}

/* Same geometry as the windows: 2 px border in the accent (rofi has focus
 * while open), 4 px corners, spacing on a 4 px scale. */
window {
    width: 40em;
    border: 2px;
    border-color: @accent;
    border-radius: 4px;
    padding: 8px 12px;
}

mainbox {
    spacing: 8px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    text-color: @fg-warm;
}

entry {
    text-color: @fg;
}

listview {
    lines: 10;
    fixed-height: false;
    scrollbar: false;
    spacing: 0;
}

element {
    padding: 4px 8px;
    border-radius: 4px;
}

element selected.normal {
    background-color: @selection;
    text-color: @fg-warm;
}

element-icon {
    background-color: inherit;
    size: 1em;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    highlight: @match-highlight;
}
