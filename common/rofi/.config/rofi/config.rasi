/* Launcher ($mod+d) and the menus in ~/Scripts, in Kanagawa Dragon.
 * rofi 1.7+ syntax. */

configuration {
    modi: "drun,run";
    show-icons: true;
    terminal: "kitty";
    matching: "fuzzy";
    drun-display-format: "{name}";
    display-drun: ">";
    display-run: "run";

    /* Ctrl+j/k move through the list. Their default bindings are cleared
     * first: rofi refuses to start when a key is bound twice. */
    kb-accept-entry: "Return,KP_Enter";
    kb-remove-to-eol: "";
    kb-row-up: "Up,Control+p,Control+k";
    kb-row-down: "Down,Control+n,Control+j";
}

/* Empty base theme: the built-in one colours list rows itself, overriding `*`. */
@theme "/dev/null"

* {
    background-color: #0d0c0c;
    text-color: #a6a69c;
    font: "JetBrainsMono Nerd Font 10";
}

window {
    width: 40em;
    border: 1px;
    border-color: #393836;
    border-radius: 4px;
    padding: 8px 12px;
}

mainbox {
    spacing: 6px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    text-color: #C8C093;
}

entry {
    text-color: #c5c9c5;
}

listview {
    lines: 10;
    fixed-height: false;
    scrollbar: false;
    spacing: 0;
}

element {
    padding: 3px 6px;
}

element selected.normal {
    background-color: #2D4F67;
    text-color: #C8C093;
}

element-icon {
    background-color: inherit;
    size: 1em;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    highlight: bold #c4b28a;
}
