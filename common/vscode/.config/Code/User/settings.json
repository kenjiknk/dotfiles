{
    // Vim keybindings (vscodevim.vim), set up for learning on the job.
    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "editor.lineNumbers": "relative",

    // Left to VS Code for now: copy, paste, find, quick open. Drop one at a
    // time as the Vim way becomes natural.
    "vim.handleKeys": {
        "<C-c>": false,
        "<C-v>": false,
        "<C-f>": false,
        "<C-p>": false
    },
    "workbench.colorTheme": "Kanagawa Dragon"
}