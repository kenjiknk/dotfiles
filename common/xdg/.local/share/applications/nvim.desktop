[Desktop Entry]
Name=Neovim
GenericName=Text Editor
Comment=Edit text files
# Sobrepõe /usr/share/applications/nvim.desktop, que usa Terminal=true.
# Sob Sway não há terminal registrado para o xdg-open resolver, então
# chamamos o kitty explicitamente.
Exec=kitty -e nvim %F
Terminal=false
Type=Application
Icon=nvim
Categories=Utility;TextEditor;
StartupNotify=false
MimeType=text/english;text/plain;text/markdown;text/x-markdown;text/csv;text/xml;text/x-makefile;text/x-c;text/x-c++;text/x-chdr;text/x-csrc;text/x-c++hdr;text/x-c++src;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;text/x-python;text/x-lua;text/x-sql;text/x-diff;text/x-log;application/json;application/x-yaml;application/toml;application/x-shellscript;application/x-desktop;
