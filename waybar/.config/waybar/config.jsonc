{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 28,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "group/tray-drawer",
    "custom/last-updated",
    "cpu",
    "memory",
    "disk",
    "network",
    "pulseaudio",
    "sway/language",
    "custom/power-profile",
    "battery",
    "clock"
  ],
  "group/tray-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 200
    },
    "modules": [
      "custom/expand",
      "tray"
    ]
  },
  "custom/expand": {
    "format": "❮",
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}",
    "on-click": "activate"
  },
  "cpu": {
    "interval": 2,
    "format": "cpu {usage}%",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "format": "mem {used:0.1f}gb",
    "interval": 2,
    "on-click": "kitty -e btop"
  },
  "custom/last-updated": {
    "exec": "~/Scripts/last-updated.sh",
    "return-type": "json",
    "interval": 3600,
    "format": "days {text}"
  },
  "disk": {
    "interval": 30,
    "format": "disk {percentage_used}%",
    "tooltip-format": "Used: {used}\nFree: {free}\nTotal: {total}",
    "path": "/",
    "on-click": "kitty -e bash -c 'duf; echo; read -n1 -s -r -p \"Press any key to close...\"'"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:L%A %d %B}",
    "tooltip": false
  },
  "network": {
    "format-wifi": "wifi {essid}",
    "format-ethernet": "eth {ifname}",
    "format-disconnected": "wifi --",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "nmgui",
    "max-length": 18
  },
  "battery": {
    "format": "bat {capacity}%",
    "format-discharging": "bat {capacity}%",
    "format-charging": "bat {capacity}%",
    "format-plugged": "bat {capacity}%",
    "tooltip-format-discharging": "{power:>1.0f}W ↓  ·  {capacity}%  ·  {time}",
    "tooltip-format-charging": "{power:>1.0f}W ↑  ·  {capacity}%  ·  {time}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip-format": "{power:>1.0f}W  ·  {capacity}%",
    "tooltip-format-full": "{power:>1.0f}W  ·  {capacity}%  ·  full",
    "tooltip-format-plugged": "{power:>1.0f}W  ·  {capacity}%  ·  plugged"
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "vol {volume}%",
    "scroll-step": 5,
    "format-muted": "vol muted"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 4
  },
  "mpris": {
    "format": "{artist} • {title}",
    "format-paused": "{artist} • {title}",
    "format-stopped": "",
    "max-length": 55
  },
  "custom/power-profile": {
    "exec": "~/Scripts/power-profile-status",
    "return-type": "json",
    "interval": 10,
    "signal": 9,
    "on-click": "~/Scripts/power-profile-menu"
  },
  "sway/language": {
    "format": "{short}",
    "tooltip-format": "{long}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
  }
}
